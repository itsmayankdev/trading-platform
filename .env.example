APP_ENV=development
APP_NAME=Trading Platform API

DATABASE_URL=postgresql+psycopg://trading_app:trading_local_password@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Owner-only admin control plane. Use strong unique values in production.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Development-only diagnostic logging
PATTERN_SEARCH_PROFILE=false
